{
  "name": "bx-ssh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.20.0"
  },
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.6.0",
      "glob@10.4.5": "10.5.0",
      "serialize-javascript": "7.0.5"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @bx-ssh/desktop tauri dev",
    "build": "pnpm --filter @bx-ssh/desktop tauri build",
    "build:web": "pnpm --filter @bx-ssh/desktop build:web",
    "bundle:report": "node scripts/report-bundle-sizes.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "pnpm --filter @bx-ssh/desktop lint",
    "typecheck": "pnpm --filter @bx-ssh/desktop typecheck",
    "test": "pnpm --filter @bx-ssh/desktop test",
    "test:e2e": "pnpm --filter @bx-ssh/desktop test:e2e",
    "cargo:fmt": "cargo fmt --all --check",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace --all-targets",
    "security:exceptions": "node scripts/check-security-exceptions.mjs",
    "security:licenses": "node scripts/check-npm-licenses.mjs --production && node scripts/check-npm-licenses.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm cargo:fmt && pnpm cargo:clippy && pnpm cargo:test"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
