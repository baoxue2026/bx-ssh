{
  "name": "bx-ssh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bx-ssh/desktop tauri dev",
    "build": "pnpm --filter @bx-ssh/desktop tauri build",
    "build:web": "pnpm --filter @bx-ssh/desktop build:web",
    "bundle:report": "node scripts/report-bundle-sizes.mjs",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "lint": "pnpm --filter @bx-ssh/desktop lint",
    "typecheck": "pnpm --filter @bx-ssh/desktop typecheck",
    "test": "pnpm --filter @bx-ssh/desktop test",
    "cargo:fmt": "cargo fmt --all --check",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace --all-targets",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm cargo:fmt && pnpm cargo:clippy && pnpm cargo:test"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
