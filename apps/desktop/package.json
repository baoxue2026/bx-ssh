{
  "name": "@bx-ssh/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "build:e2e": "cross-env VITE_E2E=true tauri build --debug --no-bundle --features e2e --config tests/e2e/tauri.e2e.conf.json",
    "ipc:generate": "cargo test --manifest-path src-tauri/Cargo.toml exports_typescript_bindings -- --ignored --nocapture",
    "ipc:check": "pnpm ipc:generate && git diff --exit-code -- src/ipc/bindings.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "test": "vitest run",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "antd": "5.29.3",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.62.0",
    "react-i18next": "17.0.11",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/junit-reporter": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "@wdio/types": "9.27.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
